                <invention-title lang="de">VORRICHTUNG ZUM SPEICHERN UND VERDAMPFEN FLÜSSIGER MEDIEN</invention-title>
                <invention-title lang="fr">DISPOSITIF DE STOCKAGE ET DE VAPORISATION DE LIQUIDE</invention-title>
                <invention-title lang="en">DEVICE FOR STORING AND VAPORIZING LIQUID MEDIA</invention-title>
