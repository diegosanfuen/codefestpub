                <invention-title lang="fr">ENSEMBLE CHARNIÈRE ET DISPOSITIF ÉLECTRONIQUE</invention-title>
                <invention-title lang="en">HINGE ASSEMBLY AND ELECTRONIC DEVICE</invention-title>
