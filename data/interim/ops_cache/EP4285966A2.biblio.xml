                <invention-title lang="fr">ACCOUPLEMENT ÉLECTRIQUE POUR DISPOSITIFS D'INJECTION</invention-title>
                <invention-title lang="en">ELECTRIC COUPLING FOR INJECTION DEVICES</invention-title>
