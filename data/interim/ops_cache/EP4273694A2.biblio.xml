                <invention-title lang="de">BEFEHLE ZUR UMWANDLUNG VON FP16 IN BF8</invention-title>
                <invention-title lang="fr">INSTRUCTIONS POUR CONVERTIR DE FP16 À BF8</invention-title>
                <invention-title lang="en">INSTRUCTIONS TO CONVERT FROM FP16 TO BF8</invention-title>
