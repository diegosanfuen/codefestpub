                <invention-title lang="de">DRUCKMATERIALBEHÄLTER UND VERWENDUNG DES DRUCKMATERIALBEHÄLTERS</invention-title>
                <invention-title lang="fr">CONTENEUR DE MATERIEL D'IMPRESSION, ET UTILISATION DU CONTENEUR DE MATERIEL D'IMPRESSION</invention-title>
                <invention-title lang="en">PRINTING MATERIAL CONTAINER, AND USE OF PRINTING MATERIAL CONTAINER</invention-title>
