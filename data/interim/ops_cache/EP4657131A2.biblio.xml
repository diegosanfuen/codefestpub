                <invention-title lang="fr">MODULE DE LENTILLE OPTIQUE ET DISPOSITIF ÉLECTRONIQUE</invention-title>
                <invention-title lang="en">OPTICAL LENS MODULE AND ELECTRONIC DEVICE</invention-title>
