                <invention-title lang="de">SEKUNDÄRBATTERIE, BATTERIEMODUL, BATTERIEPACK UND ELEKTRISCHE VORRICHTUNG</invention-title>
                <invention-title lang="fr">BATTERIE SECONDAIRE, MODULE DE BATTERIE, BLOC-BATTERIE ET APPAREIL ÉLECTRIQUE</invention-title>
                <invention-title lang="en">SECONDARY BATTERY, BATTERY MODULE, BATTERY PACK AND ELECTRICAL APPARATUS</invention-title>
