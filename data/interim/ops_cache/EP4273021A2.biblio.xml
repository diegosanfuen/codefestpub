                <invention-title lang="de">HYDRAULISCHES AUFZUGSMODUL</invention-title>
                <invention-title lang="fr">MODULE DE LEVAGE HYDRAULIQUE</invention-title>
                <invention-title lang="en">PALLET TRUCK</invention-title>
