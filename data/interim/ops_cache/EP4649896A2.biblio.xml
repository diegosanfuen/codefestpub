                <invention-title lang="de">VERSCHLUSSVORRICHTUNG AUF NAHTBASIS</invention-title>
                <invention-title lang="fr">DISPOSITIF DE FERMETURE À BASE DE SUTURE</invention-title>
                <invention-title lang="en">SUTURE BASED CLOSURE DEVICE</invention-title>
