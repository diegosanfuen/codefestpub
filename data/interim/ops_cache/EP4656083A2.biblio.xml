                <invention-title lang="de">VORRICHTUNG ZUR BEREITSTELLUNG EINES TAKTILEN STIMULUS</invention-title>
                <invention-title lang="fr">APPAREIL DE FOURNITURE DE STIMULUS TACTILE</invention-title>
                <invention-title lang="en">TACTILE STIMULUS PROVIDING APPARATUS</invention-title>
