                <invention-title lang="de">MEHRZAHL VON ANTENNEN UND ELEKTRONISCHE VORRICHTUNG DAMIT</invention-title>
                <invention-title lang="fr">PLURALITÉ D'ANTENNES ET DISPOSITIF ÉLECTRONIQUE LA COMPRENANT</invention-title>
                <invention-title lang="en">PLURALITY OF ANTENNAS AND ELECTRONIC DEVICE COMPRISING SAME</invention-title>
