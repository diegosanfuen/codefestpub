                <invention-title lang="de">HYBRIDE RESSOURCENZUORDNUNG FÜR RAR</invention-title>
                <invention-title lang="fr">MAPPAGE DE RESSOURCES HYBRIDES POUR RAR</invention-title>
                <invention-title lang="en">HYBRID RESOURCE MAPPING FOR RAR</invention-title>
