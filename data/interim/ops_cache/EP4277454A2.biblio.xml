                <invention-title lang="de">THERMOELEKTRISCHES ELEMENT</invention-title>
                <invention-title lang="fr">ÉLÉMENT THERMOÉLECTRIQUE</invention-title>
                <invention-title lang="en">THERMOELECTRIC ELEMENT</invention-title>
