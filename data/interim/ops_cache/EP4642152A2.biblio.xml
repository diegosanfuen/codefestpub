                <invention-title lang="de">INFORMATIONEN ÜBER NON-ACCESS-STRATUM-FÄHIGKEIT</invention-title>
                <invention-title lang="fr">INFORMATIONS DE CAPACITÉ DE STRATE DE NON-ACCÈS</invention-title>
                <invention-title lang="en">NON-ACCESS STRATUM CAPABILITY INFORMATION</invention-title>
