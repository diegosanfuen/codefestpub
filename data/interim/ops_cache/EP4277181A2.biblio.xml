                <invention-title lang="de">PRIORISIERUNG VON UPLINK- UND SIDELINK-ÜBERTRAGUNGEN</invention-title>
                <invention-title lang="fr">HIÉRARCHISATION DE TRANSMISSIONS DE LIAISON MONTANTE ET DE LIAISON LATÉRALE</invention-title>
                <invention-title lang="en">PRIORITIZATION OF UPLINK AND SIDELINK TRANSMISSIONS</invention-title>
