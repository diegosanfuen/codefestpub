                <invention-title lang="fr">STATION DE BASE, TERMINAL ET PROCÉDÉ DE COMMUNICATION</invention-title>
                <invention-title lang="en">BASE STATION, TERMINAL, AND COMMUNICATION METHOD</invention-title>
