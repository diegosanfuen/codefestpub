                <invention-title lang="de">NACHWEIS VON PATHOLOGIEN IN AUGENBILDERN</invention-title>
                <invention-title lang="fr">DÉTECTION DE PATHOLOGIES DANS DES IMAGES OCULAIRES</invention-title>
                <invention-title lang="en">DETECTION OF PATHOLOGIES IN OCULAR IMAGES</invention-title>
