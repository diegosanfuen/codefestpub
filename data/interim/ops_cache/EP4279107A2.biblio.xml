                <invention-title lang="de">ELEKTRISCHE STIMULATION ZUR KONSERVIERUNG UND WIEDERHERSTELLUNG EINER MEMBRANFUNKTION</invention-title>
                <invention-title lang="fr">STIMULATION ÉLECTRIQUE POUR CONSERVATION ET RÉTABLISSEMENT DE FONCTION DE DIAPHRAGME</invention-title>
                <invention-title lang="en">ELECTRICAL STIMULATION FOR PRESERVATION AND RESTORATION OF DIAPHRAGM FUNCTION</invention-title>
