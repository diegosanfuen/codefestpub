                <invention-title lang="fr">DISPOSITIF ÉLECTRONIQUE ET PROCÉDÉ DE COMMUNICATION</invention-title>
                <invention-title lang="en">ELECTRONIC DEVICE AND COMMUNICATION METHOD</invention-title>
