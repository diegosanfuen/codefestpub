                <invention-title lang="de">VORRICHTUNG UND VERFAHREN ZUR BILDCODIERUNG AUF DER BASIS VON FILTERUNG</invention-title>
                <invention-title lang="fr">APPAREIL ET PROCÉDÉ DE CODAGE D'IMAGE SUR LA BASE D'UN FILTRAGE</invention-title>
                <invention-title lang="en">APPARATUS AND METHOD FOR IMAGE CODING BASED ON FILTERING</invention-title>
