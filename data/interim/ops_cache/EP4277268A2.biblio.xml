                <invention-title lang="de">VERFAHREN UND VORRICHTUNG ZUR VIDEOCODIERUNG</invention-title>
                <invention-title lang="fr">PROCÉDÉ ET APPAREIL DE CODAGE VIDÉO</invention-title>
                <invention-title lang="en">METHOD AND APPARATUS OF VIDEO CODING</invention-title>
