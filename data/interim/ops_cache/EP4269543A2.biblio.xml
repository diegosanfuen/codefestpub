                <invention-title lang="de">POLYSILOXANHYDRAULIKFLÜSSIGKEITEN</invention-title>
                <invention-title lang="fr">FLUIDES HYDRAULIQUES À BASE DE POLYSILOXANE</invention-title>
                <invention-title lang="en">POLYSILOXANE HYDRAULIC FLUIDS</invention-title>
