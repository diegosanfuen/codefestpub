                <invention-title lang="de">VERFAHREN UND VORRICHTUNG ZUR ÜBERTRAGUNG VON DATEN</invention-title>
                <invention-title lang="fr">PROCÉDÉ ET DISPOSITIF DE TRANSMISSION DE DONNÉES</invention-title>
                <invention-title lang="en">METHOD AND DEVICE FOR TRANSMITTING DATA</invention-title>
