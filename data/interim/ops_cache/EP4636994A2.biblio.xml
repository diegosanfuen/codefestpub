                <invention-title lang="de">ROTOR EINER ELEKTRISCHEN MASCHINE UND HERSTELLUNGSVERFAHREN</invention-title>
                <invention-title lang="fr">ROTOR DE MACHINE ÉLECTRIQUE ET PROCÉDÉ DE FORMATION</invention-title>
