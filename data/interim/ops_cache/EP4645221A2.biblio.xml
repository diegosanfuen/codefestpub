                <invention-title lang="de">SYSTEM UND VERFAHREN FÜR AUF MASCHINENLERNEN BASIERENDE SENSORANALYSE UND GEFÄSSBAUMSEGMENTIERUNG</invention-title>
                <invention-title lang="fr">SYSTÈME ET PROCÉDÉ D'ANALYSE DE CAPTEUR BASÉE SUR L'APPRENTISSAGE AUTOMATIQUE ET DE SEGMENTATION D'ARBRE VASCULAIRE</invention-title>
                <invention-title lang="en">SYSTEM AND METHOD FOR MACHINE-LEARNING BASED SENSOR ANALYSIS AND VASCULAR TREE SEGMENTATION</invention-title>
                <references-cited>
