                <invention-title lang="fr">FONCTIONNEMENT À DISTANCE DE SYSTÈMES ROBOTIQUES</invention-title>
                <invention-title lang="en">REMOTE OPERATION OF ROBOTIC SYSTEMS</invention-title>
