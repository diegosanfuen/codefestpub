                <invention-title lang="de">VORRICHTUNG ZUR BEFESTIGUNG EINES PELLIKELS</invention-title>
                <invention-title lang="fr">APPAREIL DE FIXATION DE PELLICULE</invention-title>
                <invention-title lang="en">PELLICLE ATTACHMENT APPARATUS</invention-title>
