                <invention-title lang="de">VERFAHREN UND VORRICHTUNG ZUR KOMPAKTEN BESCHREIBUNG VON GEHOBENEN LOW-DENSITY PARITY-CHECK (LDPC)-CODES</invention-title>
                <invention-title lang="fr">PROCÉDÉS ET APPAREIL POUR DÉCRIRE DE MANIÈRE COMPACTE DES CODES DE CONTRÔLE DE PARITÉ À FAIBLE DENSITÉ (LDPC) ÉLEVÉS</invention-title>
                <invention-title lang="en">METHODS AND APPARATUS FOR COMPACTLY DESCRIBING LIFTED LOW-DENSITY PARITY-CHECK (LDPC) CODES</invention-title>
                <references-cited>
                    <citation cited-phase="undefined" cited-by="applicant" sequence="1">
