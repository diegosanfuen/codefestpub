                <invention-title lang="de">EINSCHÄTZUNG DER LAUFZEIT VON SENSOREN</invention-title>
                <invention-title lang="fr">ÉVALUATION DE LA DURÉE D'EXECUTION DE CAPTEURS</invention-title>
                <invention-title lang="en">RUNTIME ASSESSMENT OF SENSORS</invention-title>
