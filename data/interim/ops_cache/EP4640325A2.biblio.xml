                <invention-title lang="de">OPTISCHE ÜBERWACHUNGSVORRICHTUNG</invention-title>
                <invention-title lang="fr">DISPOSITIF DE SURVEILLANCE OPTIQUE</invention-title>
                <invention-title lang="en">OPTICAL MONITORING DEVICE</invention-title>
