                <invention-title lang="fr">DISPOSITIFS D'ENTRÉE INCORPORANT DES CAPTEURS BIOMÉTRIQUES</invention-title>
                <invention-title lang="en">INPUT DEVICES INCORPORATING BIOMETRIC SENSORS</invention-title>
