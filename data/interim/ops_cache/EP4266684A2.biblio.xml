                <invention-title lang="de">VERFAHREN UND VORRICHTUNG ZUR CODIERUNG/DECODIERUNG EINER BILDEINHEIT MIT VON EINEM LUMINANZKANAL UND MINDESTENS EINEM CHROMINANZKANAL DARGESTELLTEN BILDDATEN</invention-title>
                <invention-title lang="fr">PROCÉDÉ ET DISPOSITIF DE CODAGE/DÉCODAGE DE DONNÉES D'UNITÉ D'IMAGE REPRÉSENTÉES PAR UN CANAL DE LUMINANCE ET AU MOINS UN CANAL DE CHROMINANCE</invention-title>
                <invention-title lang="en">METHOD AND DEVICE FOR ENCODING/DECODING AN IMAGE UNIT COMPRISING IMAGE DATA REPRESENTED BY A LUMINANCE CHANNEL AND AT LEAST ONE CHROMINANCE CHANNEL</invention-title>
                <references-cited>
                    <citation cited-phase="undefined" cited-by="applicant" sequence="1">
