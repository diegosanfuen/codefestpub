                <invention-title lang="de">SORTIEREINRICHTUNG UND ZUFÜHRSCHIENE FÜR KUNSTSTOFFVORFORMLINGE</invention-title>
                <invention-title lang="fr">DISPOSITIF DE TRI ET RAIL D'ALIMENTATION POUR PRÉFORMES EN MATIÈRE PLASTIQUE</invention-title>
                <invention-title lang="en">SORTING DEVICE AND FEED RAIL FOR PLASTIC PREFORMS</invention-title>
