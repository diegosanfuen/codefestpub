                <invention-title lang="de">ANORDNUNG EINES ROBOTISCHEN CHIRURGISCHEN KLAMMERGERÄTS FÜR NACHFÜLLBARES KLAMMERMAGAZIN</invention-title>
                <invention-title lang="fr">ENSEMBLE AGRAFEUSE CHIRURGICALE ROBOTIQUE CONÇUE POUR UTILISER UN RECHARGE D'AGRAFEUSE</invention-title>
                <invention-title lang="en">ROBOTIC SURGICAL STAPLER ASSEMBLY CONFIGURED TO USE STAPLER RELOAD</invention-title>
