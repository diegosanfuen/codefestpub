                <invention-title lang="fr">SYSTÈME DE DÉVELOPPEMENT DE MODULE LOGICIEL</invention-title>
                <invention-title lang="en">SYSTEM FOR SOFTWARE MODULE DEVELOPMENT</invention-title>
